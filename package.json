{
  "name": "monorepo-ssr",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "setup": "npm install",
    "dev": "concurrently --kill-others --raw \"npm run dev --prefix apps/web\"",
    "build": "concurrently --raw \"npm run build --prefix apps/web\" && node -e \"import('node:fs').then(fs => { fs.mkdirSync('build', {recursive:true}); fs.cpSync('dist/apps/web', 'build', {recursive:true}); fs.copyFileSync('index.js', 'build/index.js'); })\"",
    "start": "concurrently --kill-others --raw \"npm run start --prefix apps/web\"",
    "lint": "concurrently --raw \"npm run lint --prefix apps/web\"",
    "typecheck": "concurrently --raw \"npm run typecheck --prefix apps/web\""
  },
  "dependencies": {
    "@react-router/express": "^8.3.0",
    "@react-router/node": "^8.3.0",
    "compression": "^1.8.1",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "knip": "^6.32.1"
  },
  "workspaces": [
    "apps/*"
  ]
}